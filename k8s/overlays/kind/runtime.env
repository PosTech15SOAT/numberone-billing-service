# TEST no Kind exige autorização específica, namespace local e vendedor de teste verificado.
SPRING_PROFILES_ACTIVE=kind
DB_URL=jdbc:postgresql://postgres:5432/numberone_billing
DB_USERNAME=billing_user
OS_SERVICE_BASE_URL=http://numberone-os-service:8080
INVENTORY_SERVICE_BASE_URL=http://numberone-inventory-service:8082
SQS_ENDPOINT=http://localstack:4566
SQS_QUEUE_URL=http://localstack:4566/queue/us-east-1/000000000000/numberone-billing-events
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_EC2_METADATA_DISABLED=true
BUDGET_NOTIFICATIONS_ENABLED=false
BUDGET_APPROVAL_BASE_URL=http://localhost:18081/api/public/orcamentos-ordem-servico/decisao
MERCADO_PAGO_ENABLED=true
MERCADO_PAGO_WEBHOOK_ENABLED=true
MANAGEMENT_ENDPOINT_HEALTH_GROUP_READINESS_INCLUDE=readinessState,db
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=65 -XX:ActiveProcessorCount=2
MERCADO_PAGO_ENVIRONMENT=TEST
MERCADO_PAGO_WEBHOOK_ENVIRONMENT=TEST
MERCADO_PAGO_KIND_TEST_ENABLED=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=julioosilva97@gmail.com
