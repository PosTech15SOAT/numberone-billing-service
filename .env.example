# Essenciais para execução local. Copie para .env e defina a senha do PostgreSQL.
DB_NAME=numberone_billing
DB_USERNAME=numberone_billing
DB_PASSWORD=replace-with-a-local-password
DB_PORT=5433

# Mockoon local publicado pelo Docker Compose para o Billing executado no host.
OS_SERVICE_BASE_URL=http://localhost:3001
INVENTORY_SERVICE_BASE_URL=http://localhost:3002
# Preencha com os tokens correspondentes ao usar os serviços reais na rede local.
BILLING_TO_OS_TOKEN=
BILLING_TO_INVENTORY_TOKEN=
OS_TO_BILLING_TOKEN=
# Destinatário dos cenários com e-mail. Para envio SMTP real, use uma caixa de teste sob seu controle.
MOCK_CUSTOMER_EMAIL=customer@example.test

# Nível geral: INFO, DEBUG, WARN, ERROR ou TRACE.
LOG_LEVEL=INFO

# Publicador local. Credenciais fictícias devem também ser exportadas no shell para o AWS SDK.
OUTBOX_ENABLED=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_PORT=4566

# Opcionais: SQS_ENDPOINT e SQS_QUEUE_URL têm padrões no profile local.
# Defaults operacionais ficam no application.properties; overrides nativos estão no README.

# Contexto de auditoria da aprovação presencial; não autentica nem autoriza acesso.
GATEWAY_EMPLOYEE_SUBJECT_HEADER=X-Authenticated-Subject

# Notificações e SMTP opcionais. Nenhum envio é habilitado automaticamente. Configure credenciais do provedor
# somente para validação manual local; testes automatizados não usam este SMTP.
BUDGET_NOTIFICATIONS_ENABLED=false

# Obrigatória para agendar solicitação mesmo com o worker desabilitado; AES-256-GCM, 32 bytes Base64. Gere com: openssl rand -base64 32. Nunca versione nem compartilhe o valor real.
BUDGET_NOTIFICATION_ENCRYPTION_KEY=

# URL completa da página pública, sem query/fragmento. Local sem HTTPS: use http://localhost:8080/api/public/orcamentos-ordem-servico/decisao; outros hosts exigem HTTPS.
BUDGET_APPROVAL_BASE_URL=https://replace-with-public-host/api/public/orcamentos-ordem-servico/decisao
# Exemplo local com Brevo. Host e porta podem apontar para outro provedor SMTP.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# Preencha com o login SMTP fornecido pelo provedor.
SMTP_USERNAME=
# Preencha manualmente com a chave SMTP do provedor; não versione nem compartilhe.
SMTP_PASSWORD=
# Use um remetente verificado/autorizado no provedor.
SMTP_FROM=

# Mercado Pago — Etapa 7A, desabilitado por padrão e permitido apenas no profile local.
# Obtenha token e User ID do vendedor independentemente no painel da aplicação, ambiente Teste.
MERCADO_PAGO_ENABLED=false
MERCADO_PAGO_ENVIRONMENT=TEST
MERCADO_PAGO_EXPECTED_TEST_SELLER_ID=
# Exporte MERCADO_PAGO_TEST_ACCESS_TOKEN no processo usando leitura silenciosa.
# Não coloque o valor real neste arquivo, no .env, em argumentos ou no histórico do terminal.
MERCADO_PAGO_TEST_ACCESS_TOKEN=

# Webhook exclusivamente local TEST. Segredo da configuração de Webhooks da aplicação, distinto do Access Token.
# Habilite somente para a sessão manual autorizada; exporte o segredo usando leitura silenciosa.
MERCADO_PAGO_WEBHOOK_ENABLED=false
MERCADO_PAGO_WEBHOOK_ENVIRONMENT=TEST
MERCADO_PAGO_WEBHOOK_SECRET=

# CT-02A sem autenticação: exclusivamente profile local e destino loopback.
PAYMENT_OS_LOCAL_UNAUTHENTICATED_ENABLED=false
PAYMENT_OS_LOCAL_BASE_URL=http://127.0.0.1:3001
